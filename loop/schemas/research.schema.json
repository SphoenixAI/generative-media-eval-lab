          },
          "category": {
            "type": "string",
            "enum": [
              "domain",
              "tooling",
              "docs",
              "test",
              "validation",
              "bugfix"
            ]
          },
          "relevance": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3,
              4
            ]
          },
          "claim_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
