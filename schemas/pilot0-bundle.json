      },
      "additionalProperties": false,
      "properties": {
        "command_template": {
          "items": {
            "type": "string"
          },
          "title": "Command Template",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/ExtractedFrame"
          },
          "title": "Frames",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "ingestion": {
          "$ref": "#/$defs/Ref"
        },
        "media": {
          "$ref": "#/$defs/Ref"
        },
        "policy": {
          "const": "first-frame-at-or-after-v1",
          "default": "first-frame-at-or-after-v1",
          "title": "Policy",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "tool": {
          "$ref": "#/$defs/ToolIdentity"
        },
        "transforms": {
          "const": "software decode; one thread; coded orientation; RGB24 PNG; no tone mapping; no crop/scale",
          "default": "software decode; one thread; coded orientation; RGB24 PNG; no tone mapping; no crop/scale",
          "title": "Transforms",
          "type": "string"
        }
      },
      "required": [
        "id",
        "ingestion",
        "media",
        "source_sha256",
        "tool",
        "command_template",
        "frames"
      ],
      "title": "DerivativeManifest",
      "type": "object"
    },
