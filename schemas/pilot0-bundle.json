{
  "dataset_manifest_schema": {
    "$defs": {
      "Ref": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "minLength": 1,
            "title": "Kind",
            "type": "string"
          },
          "revision": {
            "default": 1,
            "minimum": 1,
            "title": "Revision",
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "id"
        ],
        "title": "Ref",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "state": {
              "const": "ready"
            }
          },
          "required": [
            "state"
          ]
        },
        "then": {
          "properties": {
            "clips": {
              "minItems": 12
            }
          }
        }
      }
    ],
    "properties": {
      "clips": {
        "default": [],
        "items": {
          "$ref": "#/$defs/Ref"
        },
        "maxItems": 20,
        "title": "Clips",
        "type": "array"
      },
      "created_at": {
        "format": "date-time",
        "title": "Created At",
        "type": "string"
      },
      "id": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
        "title": "Id",
        "type": "string"
      },
      "owner": {
        "minLength": 1,
        "title": "Owner",
        "type": "string"
      },
      "revision": {
        "default": 1,
        "minimum": 1,
        "title": "Revision",
        "type": "integer"
      },
      "schema_version": {
        "const": 1,
        "default": 1,
        "title": "Schema Version",
        "type": "integer"
      },
      "state": {
        "default": "draft",
        "enum": [
          "draft",
          "ready"
        ],
        "title": "State",
        "type": "string"
      },
      "target_maximum": {
        "const": 20,
        "default": 20,
        "title": "Target Maximum",
        "type": "integer"
      },
      "target_minimum": {
        "const": 12,
        "default": 12,
        "title": "Target Minimum",
        "type": "integer"
      }
    },
    "required": [
      "id",
      "owner"
    ],
    "title": "PilotDataset",
    "type": "object"
  },
  "human_form_schemas": {
    "confidence": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence"
        },
        "evidence_role": {
          "enum": [
            "supporting",
            "contradicting",
            "context_only"
          ],
          "title": "Evidence Role",
          "type": "string"
        },
        "new_evidence": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "New Evidence",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "confidence",
        "reason",
        "new_evidence",
        "evidence_role"
      ],
      "title": "ConfidenceInput",
      "type": "object"
    },
    "hypothesis": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "contradicting_evidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Contradicting Evidence",
          "type": "array"
        },
        "discriminating_test": {
          "minLength": 1,
          "title": "Discriminating Test",
          "type": "string"
        },
        "evidence_required": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Required",
          "type": "array"
        },
        "falsifying_observation": {
          "minLength": 1,
          "title": "Falsifying Observation",
          "type": "string"
        },
        "observed_problem": {
          "minLength": 1,
          "title": "Observed Problem",
          "type": "string"
        },
        "predicted_observation": {
          "minLength": 1,
          "title": "Predicted Observation",
          "type": "string"
        },
        "proposed_cause": {
          "minLength": 1,
          "title": "Proposed Cause",
          "type": "string"
        },
        "supporting_evidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence",
          "type": "array"
        }
      },
      "required": [
        "observed_problem",
        "proposed_cause",
        "evidence_required",
        "discriminating_test",
        "predicted_observation",
        "falsifying_observation"
      ],
      "title": "HypothesisInput",
      "type": "object"
    },
    "intent": {
      "$defs": {
        "Criterion": {
          "additionalProperties": false,
          "properties": {
            "acceptance": {
              "minLength": 1,
              "title": "Acceptance",
              "type": "string"
            },
            "applicability": {
              "default": "required",
              "enum": [
                "required",
                "optional",
                "not_applicable"
              ],
              "title": "Applicability",
              "type": "string"
            },
            "dimension": {
              "$ref": "#/$defs/Dimension"
            },
            "rationale": {
              "minLength": 1,
              "title": "Rationale",
              "type": "string"
            }
          },
          "required": [
            "dimension",
            "rationale",
            "acceptance"
          ],
          "title": "Criterion",
          "type": "object"
        },
        "Dimension": {
          "enum": [
            "prompt_adherence",
            "subject_consistency",
            "semantic_consistency",
            "temporal_consistency",
            "temporal_geometry",
            "motion_plausibility",
            "occlusion_consistency",
            "lighting_continuity",
            "camera_language",
            "composition",
            "artifacting",
            "aesthetic_quality",
            "editability"
          ],
          "title": "Dimension",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "audience": {
          "minLength": 1,
          "title": "Audience",
          "type": "string"
        },
        "constraints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "context": {
          "minLength": 1,
          "title": "Context",
          "type": "string"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "title": "Criteria",
          "type": "array"
        },
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "prohibited_outcomes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Prohibited Outcomes",
          "type": "array"
        },
        "revision_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision Reason"
        }
      },
      "required": [
        "objective",
        "audience",
        "context",
        "criteria"
      ],
      "title": "IntentInput",
      "type": "object"
    },
    "observation": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "derivative_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Derivative Id"
        },
        "frame_indices": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Frame Indices",
          "type": "array"
        },
        "observation": {
          "minLength": 1,
          "title": "Observation",
          "type": "string"
        },
        "timestamp_end": {
          "minimum": 0,
          "title": "Timestamp End",
          "type": "number"
        },
        "timestamp_start": {
          "minimum": 0,
          "title": "Timestamp Start",
          "type": "number"
        }
      },
      "required": [
        "observation",
        "timestamp_start",
        "timestamp_end"
      ],
      "title": "ObservationInput",
      "type": "object"
    },
    "relation": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "evidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "object": {
          "minLength": 1,
          "title": "Object",
          "type": "string"
        },
        "object_kind": {
          "enum": [
            "Hypothesis",
            "IntentSpec"
          ],
          "title": "Object Kind",
          "type": "string"
        },
        "predicate": {
          "enum": [
            "supports",
            "contradicts",
            "motivated_by",
            "fulfills",
            "violates",
            "alternative_to"
          ],
          "title": "Predicate",
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "subject_kind": {
          "enum": [
            "Evidence",
            "Hypothesis"
          ],
          "title": "Subject Kind",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "subject_kind",
        "predicate",
        "object",
        "object_kind",
        "purpose",
        "scope"
      ],
      "title": "RelationInput",
      "type": "object"
    }
  },
  "record_schemas": {
    "DerivativeManifest": {
      "$defs": {
        "ExtractedFrame": {
          "additionalProperties": false,
          "properties": {
            "actual_seconds": {
              "minimum": 0,
              "title": "Actual Seconds",
              "type": "number"
            },
            "frame_index": {
              "minimum": 0,
              "title": "Frame Index",
              "type": "integer"
            },
            "height": {
              "exclusiveMinimum": 0,
              "title": "Height",
              "type": "integer"
            },
            "pts": {
              "title": "Pts",
              "type": "integer"
            },
            "relative_path": {
              "minLength": 1,
              "title": "Relative Path",
              "type": "string"
            },
            "requested_seconds": {
              "minimum": 0,
              "title": "Requested Seconds",
              "type": "number"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Sha256",
              "type": "string"
            },
            "width": {
              "exclusiveMinimum": 0,
              "title": "Width",
              "type": "integer"
            }
          },
          "required": [
            "requested_seconds",
            "frame_index",
            "pts",
            "actual_seconds",
