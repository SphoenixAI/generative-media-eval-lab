        "ToolIdentity": {
          "additionalProperties": false,
          "properties": {
            "executable_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "title": "Executable Sha256",
              "type": "string"
            },
            "name": {
              "enum": [
                "ffmpeg",
                "ffprobe"
              ],
              "title": "Name",
              "type": "string"
            },
            "version": {
              "minLength": 1,
              "title": "Version",
              "type": "string"
            }
          },
          "required": [
            "name",
            "version",
            "executable_sha256"
          ],
          "title": "ToolIdentity",
          "type": "object"
