{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "ready"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "clips": {
            "minItems": 12
          }
        }
      }
    }
  ],
  "properties": {
    "id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "owner": {
      "minLength": 1,
      "title": "Owner",
      "type": "string"
    },
    "state": {
      "default": "draft",
      "enum": [
        "draft",
        "ready"
      ],
      "title": "State",
      "type": "string"
    },
    "target_minimum": {
      "const": 12,
      "default": 12,
      "title": "Target Minimum",
      "type": "integer"
    },
    "target_maximum": {
      "const": 20,
      "default": 20,
      "title": "Target Maximum",
      "type": "integer"
    },
    "clips": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "maxItems": 20,
      "title": "Clips",
      "type": "array"
    }
  },
  "required": [
    "id",
    "owner"
  ],
  "title": "PilotDataset",
  "type": "object"
}
